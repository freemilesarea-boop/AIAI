{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "infra/docker/worker.Dockerfile"
  },
  "deploy": {
    "startCommand": "/app/.venv/bin/python scripts/ops/billing_reconcile.py",
    "cronSchedule": "17 3 * * *",
    "restartPolicyType": "NEVER",
    "numReplicas": 1
  }
}
