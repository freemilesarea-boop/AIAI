# Dependencies
node_modules/
.pnpm-store/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# Next.js
apps/web/.next/
apps/web/out/
apps/web/next-env.d.ts
.vercel/

# Environment — never commit real secrets (.env.example only)
.env
.env.*
!.env.example

# Test / coverage
coverage/
.coverage
htmlcov/
*.lcov

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Local data
*.local
postgres-data/
redis-data/

# Local runtime logs (API / worker / web dev servers)
logs-local/

# Model weights are never committed (see models/README.md)
models/**/*.safetensors
models/**/*.ckpt
models/**/*.pt
models/**/*.bin

# Generated audio artifacts
*.wav
*.mp3
!tests/fixtures/**/*.wav

# TypeScript incremental build info
*.tsbuildinfo

# Local audio storage output
data/

# Phase 20: benchmark and dataset artefacts stay out of git.
# Audio is large, often not ours to redistribute, and reproducible from
# the frozen manifest. Manifests and metadata are committed; audio,
# derived features and checkpoints are not.
benchmarks/music_quality/results/p20_objective_baseline.json
datasets/
*.ckpt
*.safetensors

# Training orchestration outputs. Run artifacts, checkpoints, metrics and
# registries are operator state, often large, and sometimes describe a
# private library. They are never committed.
training_runs/
training-registry/
worker_capabilities.json
