# ── LUBER MUSIC AI — environment template ──────────────────────────────
# Copy to .env and adjust. Never commit a real .env file.

# Environment: development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (docker-compose service: postgres)
POSTGRES_USER=luber
POSTGRES_PASSWORD=luber_dev_password
POSTGRES_DB=luber
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://luber:luber_dev_password@localhost:5432/luber

# Redis (docker-compose service: redis)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# FastAPI backend
API_HOST=0.0.0.0
API_PORT=8000

# Next.js frontend
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── Audio storage ──────────────────────────────────────────────────────
# Backend for generation audio: local | s3
STORAGE_PROVIDER=local

# Local adapter (development). Objects land under {dir}/audio/{id}/.
AUDIO_STORAGE_DIR=data

# S3-compatible adapter (production). Works with AWS S3, Cloudflare R2,
# MinIO, Backblaze B2, Supabase Storage — vary endpoint/region/path-style.
# NEVER commit real credentials: supply them via the environment.
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Required by MinIO and some self-hosted S3 gateways.
STORAGE_FORCE_PATH_STYLE=false
# Optional prefix so one bucket can serve several environments.
STORAGE_KEY_PREFIX=

# Generation provider: mock | ace_step
GENERATION_PROVIDER=mock

# ACE-Step provider (when GENERATION_PROVIDER=ace_step).
# Pinned upstream: see docs/ACE_STEP_UPSTREAM_AUDIT.md
ACE_STEP_BASE_URL=http://127.0.0.1:8001
ACE_STEP_API_KEY=
ACE_STEP_MODEL=acestep-v15-turbo
ACE_STEP_REQUEST_TIMEOUT=60
ACE_STEP_GENERATION_TIMEOUT=600
ACE_STEP_POLL_INTERVAL=2
ACE_STEP_OUTPUT_DIR=data/raw-model-output
ACE_STEP_INFERENCE_STEPS=8
ACE_STEP_THINKING=false

# --- Operations -------------------------------------------------------
# Where supervised processes write their logs. Defaults to ~/.luber/log.
# Set this to wherever the deployment platform collects logs.
LUBER_LOG_DIR=

# How long an uploaded reference audio file survives without any
# generation using it, and how many are removed per cleanup run.
REFERENCE_ABANDONMENT_GRACE_HOURS=24
REFERENCE_CLEANUP_BATCH_SIZE=100

# --- Operator training console (Phase 28) -----------------------------
# The console exposes training internals — dataset identities, checkpoint
# digests, worker hosts, trainer logs — and can spend money on rented
# hardware. LUBER has no operator role on `User` yet, so the boundary is
# the deployment rather than the session: off by default, refused
# outright when ENVIRONMENT=production, and a shared token required even
# when on. See docs/TRAINING_CONSOLE.md.
OPS_CONSOLE_ENABLED=false
# Required whenever the console is enabled. A long random string —
# enabled with no token is refused rather than served unauthenticated.
# The web server needs the same value: it attaches the token server-side
# so a browser never holds one. Never prefix this NEXT_PUBLIC_.
OPS_OPERATOR_TOKEN=

# Where the Phase 25 training registry and its run artifacts live.
OPS_REGISTRY_ROOT=training-registry
OPS_ARTIFACTS_ROOT=

# Roots the dataset and curation build catalogues are enumerated from.
# The console offers what it finds inside these, by identifier — no
# request anywhere in the operator API accepts a filesystem path.
OPS_DATASET_BUILDS_ROOT=
OPS_CURATION_BUILDS_ROOT=

# How the console reaches a worker: "none" (default) or "local".
# There is deliberately no "ssh" option — SSH endpoints and key
# references are operator credentials that the CLI holds, and moving
# them into a browser-reachable process would change the Phase 27
# security boundary for the sake of a button.
OPS_WORKER_TRANSPORT=none
OPS_WORKER_ROOT=

# Ceiling on rows in one operator list response.
OPS_PAGE_SIZE_LIMIT=200

# The Next server proxies /ops/api to the API and attaches the operator
# token. It needs OPS_CONSOLE_ENABLED, OPS_OPERATOR_TOKEN and:
API_PROXY_TARGET=http://127.0.0.1:8000

# ── PayApp recurring billing (Phase 7) ───────────────────────────────
#
# Server-side only. None of these reaches the browser: the frontend asks
# for a plan by name and receives a PayApp-hosted URL, which is all it
# needs. Never commit real values — this file holds placeholders and the
# real ones live in .env, which is gitignored.
#
# Billing is off unless USERID, LINKKEY and LINKVAL are all set. A
# half-configured integration is worse than none: it could register real
# recurring contracts while being unable to validate the notifications
# that confirm them.
PAYAPP_USERID=
# Sent on outbound API calls, and one of the three values compared in
# constant time on every inbound notification.
PAYAPP_LINKKEY=
# PayApp's 연동 VALUE. Notification-only — never sent outbound. Leaking
# it cannot place a charge, but it could be used to forge a payment
# notification, so it is held to the same standard as the key.
PAYAPP_LINKVAL=
PAYAPP_API_URL=https://api.payapp.kr/oapi/apiLoad.html

# Public base URL PayApp posts feedback and failure notifications to.
# Must be reachable from the internet — localhost is not, so testing
# callbacks locally needs a tunnel. There is no way around that.
PAYAPP_PUBLIC_BASE_URL=http://localhost:8000
# Where the browser lands after PayApp. UX only: reaching it proves
# nothing and activates nothing.
PAYAPP_RETURN_BASE_URL=http://localhost:3000

# Throttle for the public notification endpoints. They cannot require a
# session, so this is what stops the audit trail from doubling as a way
# to fill the database.
PAYAPP_FEEDBACK_RATE_LIMIT=120
PAYAPP_FEEDBACK_RATE_WINDOW_SECONDS=60
